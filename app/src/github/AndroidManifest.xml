<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GitHub version only: lets Unwind hand a downloaded update to Android to install. Android asks you to switch it on. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Android reports back here while an update installs (shows the "Install?" screen, or an error) -->
        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
